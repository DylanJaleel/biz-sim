// Prisma schema for Boardroom.
// Provider stays "postgresql": local dev talks to PGlite via a Postgres-wire
// socket, production talks to a managed Postgres (see docs/deployment-vercel.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime   @default(now())
  game          Game?
  saves         GameSave[]
}

// Required by the Auth.js email (magic link) provider. Sessions are JWT-based,
// so no Session/Account tables are needed.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One game per player. The whole game is a JSON document produced by the pure
// engine in lib/game; `revision` guards against stale tabs and double taps.
model Game {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     Json
  month     Int      @default(1)
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Backups of a game: automatic ones after every month close and before a
// restore or a restart, plus named saves the player makes. `summary` holds the
// few numbers the list shows, so listing never loads whole games.
model GameSave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "auto" | "manual" | "backup"
  kind      String
  name      String
  state     Json
  summary   Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Fixed-window counters for abuse protection (see lib/rate-limit.ts). Lives in
// the database because serverless instances share no memory.
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Estimated database usage per calendar month (see lib/usage.ts). Feeds the
// cost estimate on the account page and the monthly budget stop.
model DbUsage {
  /// "2026-10"
  month         String    @id
  activeSeconds Int       @default(0)
  bytesRead     BigInt    @default(0)
  bytesWritten  BigInt    @default(0)
  queries       Int       @default(0)
  lastActiveAt  DateTime?
  updatedAt     DateTime  @updatedAt
}
