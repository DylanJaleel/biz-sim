{
  "name": "biz-sim",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "DATABASE_URL=\"postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=3\" pglite-server --db=./.pglite-data --port=5433 --max-connections=5 --run \"next dev\"",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate-game.ts",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "DATABASE_URL=\"postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable\" pglite-server --db=./.pglite-data --port=5433 --max-connections=5 --run \"prisma migrate deploy\"",
    "db:migration": "node scripts/create-migration.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "DATABASE_URL=\"postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable\" pglite-server --db=./.pglite-data --port=5433 --max-connections=5 --run \"prisma studio\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "motion": "^12.43.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@prisma/client": "^6",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.160.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3"
  }
}
