# --- Required everywhere -----------------------------------------------------
# Signs the session JWT / magic-link tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Local development -------------------------------------------------------
# DATABASE_URL is injected automatically by `npm run dev` / `db:*` (local PGlite).
# Without RESEND_API_KEY the magic link is printed to the dev server console.
#
# Copy this file to .env.local and set AUTH_SECRET.

# --- Production (Vercel: set these under Project Settings > Environment Variables) ---
# Managed Postgres. Use the *pooled* connection string at runtime (serverless).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Optional: direct (non-pooled) connection used only for `prisma migrate deploy`
# during the production build. Falls back to DATABASE_URL_UNPOOLED (set by the
# Neon integration), then DATABASE_URL.
MIGRATE_DATABASE_URL=""
# Resend (https://resend.com, free tier). The sender must be on a verified domain.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Business Simulator <login@your-verified-domain.example>"
# Only when NOT hosting on Vercel (there the host is trusted automatically):
# AUTH_TRUST_HOST=true
